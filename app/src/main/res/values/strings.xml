    <!-- Panduan Mahasiswa -->
    <string name="guide_mhs_title">Cara Penggunaan (Mahasiswa)</string>
    <string name="guide_mhs_subtitle">Ikuti 4 langkah mudah berikut untuk mengambil dan memantau antrean layanan kampus:</string>
    <string name="guide_mhs_step1_title">1. Pilih Layanan Kampus</string>
    <string name="guide_mhs_step1_desc">Buka tab Layanan, gunakan kolom pencarian jika perlu, lalu ketuk layanan akademik yang dituju untuk melihat syarat berkas.</string>
    <string name="guide_mhs_step2_title">2. Ambil Nomor Antrean</string>
    <string name="guide_mhs_step2_desc">Pastikan kuota harian masih tersedia dan persyaratan berkas sudah lengkap, lalu tekan tombol Ambil Nomor Antrean.</string>
    <string name="guide_mhs_step3_title">3. Pantau Status &amp; Tiket QR Code</string>
    <string name="guide_mhs_step3_desc">Buka tab Antrean Saya untuk melihat sisa antrean di depan, estimasi waktu tunggu, dan kode QR tiket Anda.</string>
    <string name="guide_mhs_step4_title">4. Menuju Loket Saat Dipanggil</string>
    <string name="guide_mhs_step4_desc">Saat notifikasi panggilan muncul, segera menuju loket pelayanan dan tunjukkan kode QR pada layar kepada petugas.</string>

    <!-- Panduan Admin -->
    <string name="guide_admin_title">Cara Penggunaan (Petugas Loket)</string>
    <string name="guide_admin_subtitle">Panduan pengelolaan layanan dan pemanggilan antrean harian untuk Administrator:</string>
    <string name="guide_admin_step1_title">1. Kelola Jenis Layanan</string>
    <string name="guide_admin_step1_desc">Buka tab Kelola Layanan untuk menambah, mengubah, menutup sementara, atau menghapus layanan akademik beserta kuota hariannya.</string>
    <string name="guide_admin_step2_title">2. Panggil Antrean Berikutnya</string>
    <string name="guide_admin_step2_desc">Pada tab Antrean Aktif, tekan Panggil Berikutnya. Sistem otomatis mengumumkan nomor antrean lewat suara (TTS) dan mengirim notifikasi ke mahasiswa.</string>
    <string name="guide_admin_step3_title">3. Selesaikan Layanan Loket</string>
    <string name="guide_admin_step3_desc">Setelah berkas mahasiswa selesai diproses di loket, tekan tombol Selesai Layani agar antrean masuk ke riwayat dan siap memanggil nomor berikutnya.</string>
    <string name="guide_admin_step4_title">4. Atur Nomor Loket &amp; Suara</string>
    <string name="guide_admin_step4_desc">Gunakan menu Pengaturan Loket &amp; Suara untuk menyesuaikan nama loket tujuan dan kecepatan pelafalan suara pengumuman.</string>

