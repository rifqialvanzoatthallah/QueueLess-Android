<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Handle Geser Atas -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@color/divider_gray" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_admin_settings"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Switch Panggilan Suara Otomatis -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAdminTts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/label_switch_admin_tts"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            app:thumbTint="@color/switch_thumb_tint"
            app:trackTint="@color/switch_track_tint" />

        <!-- Input Nama / Nomor Loket -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAdminCounterName"
            style="@style/Widget.QueueLess.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/hint_admin_counter_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAdminCounterName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Pilihan Kecepatan Pelafalan -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/label_tts_speed"
            android:textColor="@color/primary_blue"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleTtsSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpeedSlow"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/speed_slow"
                android:textSize="12sp"
                app:strokeColor="@color/primary_blue" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpeedNormal"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/speed_normal"
                android:textSize="12sp"
                app:strokeColor="@color/primary_blue" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpeedFast"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/speed_fast"
                android:textSize="12sp"
                app:strokeColor="@color/primary_blue" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Tombol Uji Suara & Simpan Pengaturan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestAdminTts"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/btn_test_tts"
                android:textColor="@color/primary_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/primary_blue" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveAdminSettings"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/btn_save_settings"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary_blue"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/divider_gray" />

        <!-- Bagian Foto Profil Admin -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_profile_photo"
            android:textColor="@color/primary_blue"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdminChangePhotoSheet"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/btn_choose_gallery_photo"
                android:textColor="@color/primary_blue_dark"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary_blue_light"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdminDeletePhotoSheet"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/btn_remove_profile_photo"
                android:textColor="@color/error_red"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/error_red" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/divider_gray" />

        <!-- Bagian Tentang Aplikasi -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_about_app"
            android:textColor="@color/primary_blue"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdminAboutApp"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:text="@string/btn_about_app"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/background_light"
            app:cornerRadius="12dp" />
    </LinearLayout>
</ScrollView>